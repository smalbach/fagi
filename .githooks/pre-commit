#!/bin/sh
# Every commit bumps the version (patch) in package.json and package-lock.json, so
# every build that reaches production carries a distinct number and you know which it is.
# To skip it: FAGI_NO_BUMP=1 git commit ...  (for example when redoing a commit).
[ -n "$FAGI_NO_BUMP" ] && exit 0
# Leave it alone during a merge or a rebase: the version already comes in the commits.
GIT_DIR=$(git rev-parse --git-dir)
[ -f "$GIT_DIR/MERGE_HEAD" ] && exit 0
[ -d "$GIT_DIR/rebase-merge" ] || [ -d "$GIT_DIR/rebase-apply" ] && exit 0
npm version patch --no-git-tag-version --silent >/dev/null || exit 1
git add package.json package-lock.json
