# Copy this file to .env and adjust. npm run start:dev / migrate / test read it on their own.
DATABASE_URL=postgres://user:password@localhost:5432/fagi
# Separate database for the server tests (it is WIPED entirely on every test). Without it, they are skipped.
DATABASE_URL_TEST=postgres://user:password@localhost:5432/fagi_test
# The account that signs up with this email starts out approved and as admin.
ADMIN_EMAIL=you@example.com
PORT=8787
# "Forgot password" emails go through Brevo (Brevo → SMTP & API → API keys).
# Without BREVO_API_KEY, outside production the email is printed to the console instead.
BREVO_API_KEY=
# Sender: must be a sender or domain verified in Brevo.
MAIL_FROM_EMAIL=no-reply@example.com
MAIL_FROM_NAME=Fagi
# Public address of the site, used to build the link in the email. Required in
# production (it is never taken from the request's Host header there).
APP_URL=http://localhost:5173
