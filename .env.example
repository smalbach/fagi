# Copy this file to .env and adjust. npm run start:dev / migrate / test read it on their own.
DATABASE_URL=postgres://user:password@localhost:5432/fagi
# Separate database for the server tests (it is WIPED entirely on every test). Without it, they are skipped.
DATABASE_URL_TEST=postgres://user:password@localhost:5432/fagi_test
# The account that signs up with this email starts out approved and as admin.
ADMIN_EMAIL=you@example.com
PORT=8787
