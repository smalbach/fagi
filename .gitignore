# Dependencies: rebuilt with `npm install` from package-lock.json.
node_modules
node_modules/

# Vite build: comes out of `npm run build`, not versioned.
dist/
*.local
.vite/

# Logs and npm dumps.
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Secrets and machine-specific settings.
.env
.env.*
!.env.example

# Personal Claude Code settings. launch.json IS versioned: it says how to
# start the project and that holds for everyone.
.claude/settings.local.json

# Editors.
.vscode/*
!.vscode/extensions.json
.idea/

# macOS.
.DS_Store

# Research runs: regenerated by `node research/run.js` from the design and the
# commit in manifest.json. Only the manifest and the summary are kept.
research/results/*/rows.csv
research/results/*/genealogy.jsonl
research/results/*/summary.json
research/results/game-confirm/*.json
research/results/game-confirm/*.log
research/results/game-confirm/parts/

# Adaptive decision, confirmation: 4800 episodes, regenerated by battery.js
# from the frozen protocol; kept as confirmation.csv (one row per episode).
research/results/adaptive-decision/food/conf-*/*
!research/results/adaptive-decision/food/conf-*/run.json

# Rules of conduct, lineages: 14 400 lives regenerated by lineages.js; kept as lineages.csv.
research/results/adaptive-decision/lineages/*/
research/results/adaptive-decision/caution/*/

# Code culture, step 0: one file per life, regenerated by seeded.js; run.json and the report are kept.
research/results/code-culture/seeded/*/r[0-9]*-g[0-9]*-k[0-9]*.json
research/results/code-culture/*.log
research/results/code-culture/step1/*/*-[0-9]*.json
research/results/code-culture/viability/*/*/*.json
research/results/code-culture/lineages/*/r*-g*-k*.json
research/results/code-culture/lineages/current/
research/results/code-culture/transplant/
research/results/code-culture/rule-calibrate/
research/results/code-culture/rule-transplant/
research/results/code-culture/lineages/*/current-n*.json
# Code culture: the model call archive and the texts per lineage (~39 MB); kept on branch research/codigo-cultural.
research/results/code-culture/archive.jsonl
research/results/code-culture/*/*/texts.json
